#include<stdio.h>
#define INF 999
int main(){
    int a[10][10],d[10],v[10]={0},n,s,i,j,u,min;
    scanf("%d",&n);
    for(i=0;i<n;i++)
        for(j=0;j<n;j++){
            scanf("%d",&a[i][j]);
            if(a[i][j]==0 && i!=j) a[i][j]=INF;
        }
    scanf("%d",&s);

    for(i=0;i<n;i++) d[i]=a[s][i];
    d[s]=0; v[s]=1;

    for(i=1;i<n;i++){
        min=INF; u=-1;
        for(j=0;j<n;j++)
            if(!v[j]&&d[j]<min) min=d[j],u=j;
        if(u==-1) break;
        v[u]=1;
        for(j=0;j<n;j++)
            if(!v[j]&&d[u]+a[u][j]<d[j])
                d[j]=d[u]+a[u][j];
    }
    for(i=0;i<n;i++) printf("%d -> %d\n",i,d[i]);
}
