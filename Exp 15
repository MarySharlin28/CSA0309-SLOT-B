#include<stdio.h>
#define N 10
int h[N];

int main(){
    int n,x,i,p;
    for(i=0;i<N;i++)h[i]=-1;
    scanf("%d",&n);
    while(n--){
        scanf("%d",&x);
        p=x%N;
        while(h[p]!=-1)p=(p+1)%N;
        h[p]=x;
    }
    for(i=0;i<N;i++)
        if(h[i]!=-1)printf("%d -> %d\n",i,h[i]);
}
