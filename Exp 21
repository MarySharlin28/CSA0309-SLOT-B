#include<stdio.h>
int main(){
    int a[10][10],q[10],v,n,s,i,j,f=0,r=0,vis[10]={0};
    scanf("%d",&n);
    for(i=0;i<n;i++)
        for(j=0;j<n;j++) scanf("%d",&a[i][j]);
    scanf("%d",&s);

    q[r++]=s; vis[s]=1;
    while(f<r){
        v=q[f++];
        printf("%d ",v);
        for(i=0;i<n;i++)
            if(a[v][i]&&!vis[i])
                vis[i]=1,q[r++]=i;
    }
}
