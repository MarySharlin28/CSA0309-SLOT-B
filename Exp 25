#include<stdio.h>
int p[20];

int find(int x){
    while(p[x]!=x)x=p[x];
    return x;
}

int main(){
    int a[20][3],n,e,i,j,t,c=0,k=0,x,y;
    scanf("%d%d",&n,&e);

    for(i=0;i<e;i++)
        scanf("%d%d%d",&a[i][0],&a[i][1],&a[i][2]);

    for(i=0;i<n;i++)p[i]=i;

    for(i=0;i<e-1;i++)
        for(j=i+1;j<e;j++)
            if(a[i][2]>a[j][2]){
                t=a[i][0];a[i][0]=a[j][0];a[j][0]=t;
                t=a[i][1];a[i][1]=a[j][1];a[j][1]=t;
                t=a[i][2];a[i][2]=a[j][2];a[j][2]=t;
            }

    for(i=0;i<e&&k<n-1;i++){
        x=find(a[i][0]); y=find(a[i][1]);
        if(x!=y){
            p[x]=y;
            printf("%d - %d : %d\n",a[i][0],a[i][1],a[i][2]);
            c+=a[i][2]; k++;
        }
    }
    printf("Cost = %d",c);
}
